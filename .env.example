# Minihood — environment variables
#
# This app is 100% independent: its own database, its own admin key, its own
# domain. It does not read from, write to, or depend on any other project's
# infrastructure. Copy this file to `.env.local` for local development, and
# set the same names in the Vercel project's Environment Variables settings
# for production/preview.

# --- Public (safe to expose in the browser bundle) ---------------------------

# Canonical production URL, used for Open Graph / Twitter card metadata.
NEXT_PUBLIC_SITE_URL=https://minihood.example

# Optional override for the wallet-submit endpoint. Leave unset — it defaults
# to Minihood's own same-origin /api/wallet route.
NEXT_PUBLIC_WALLET_SUBMIT_ENDPOINT=

# Optional: social task verification endpoint (lib/social-tasks.ts). Leave
# unset to run in self-reported mode — the user opens the real task URL and
# confirms manually; the UI discloses this. No X API integration exists yet.
NEXT_PUBLIC_VERIFY_TASK_ENDPOINT=

# --- Server-only secrets (NEVER prefix these with NEXT_PUBLIC_) --------------

# Minihood's own Postgres connection string. Not shared with any other
# project's database.
DATABASE_URL=postgresql://user:password@host:5432/minihood

# Set to "true" when DATABASE_URL points at a managed Postgres that requires
# SSL (Neon, Render, Supabase, RDS, etc). Leave "false" for local Postgres
# without SSL.
DATABASE_SSL=false

# Secret required in the `x-admin-key` header to reach /api/admin/* and the
# /admin dashboard. Generate a long random value, e.g. `openssl rand -hex 32`.
# Without this set, the admin API refuses all requests (fails closed).
ADMIN_API_KEY=change-me-to-a-long-random-secret

# Salt mixed into hashed IP addresses stored alongside wallet submissions
# (used only for basic per-IP abuse throttling — raw IPs are never stored).
# Generate a long random value, distinct from ADMIN_API_KEY.
IP_HASH_SALT=change-me-too
